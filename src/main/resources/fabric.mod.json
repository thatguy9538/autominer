{
  "schemaVersion": 1,
  "id": "autominer",
  "version": "${version}",
  "name": "Auto Miner",
  "description": "Pick a block type and automatically mine every block of that type within your reach. G = select block, H = toggle.",
  "authors": ["You"],
  "license": "MIT",
  "environment": "client",
  "mixins": ["autominer.mixins.json"],
  "entrypoints": {
    "client": ["com.example.autominer.AutoMinerClient"]
  },
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~1.21.10",
    "java": ">=21",
    "fabric-api": "*"
  }
}
