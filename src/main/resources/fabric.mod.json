    "You"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.powderassist.PowderAssistClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~1.21.10",
    "java": ">=21",
    "fabric-api": "*"
  },
  "mixins": [
    "powderassist.mixins.json"
  ]
}