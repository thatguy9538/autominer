{
  "schemaVersion": 1,
  "id": "multibind",
  "version": "${version}",
  "name": "Multi Bind",
  "description": "Give any action more than one key: add extra keys or mouse buttons to jump, attack, sprint or any mod's key binding. Set them up in Mod Menu.",
  "authors": ["You"],
  "license": "MIT",
  "environment": "client",
  "mixins": ["multibind.mixins.json"],
  "entrypoints": {
    "client": ["com.example.multibind.MultiBindClient"],
    "modmenu": ["com.example.multibind.ModMenuIntegration"]
  },
  "depends": { "fabricloader": ">=0.17.0", "minecraft": "~1.21.10", "java": ">=21", "fabric-api": "*" },
  "suggests": { "modmenu": "*" }
}
