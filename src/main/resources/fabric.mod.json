{
  "schemaVersion": 1,
  "id": "ghostbot",
  "version": "${version}",
  "name": "Ghost Bot",
  "description": "Kills the Ghosts in The Mist (Dwarven Mines) by itself, with human-like aiming, path-finding, roaming, an ability item, and a kill / drop tracker. Fighting adapted from V5 (GPL-3.0). /gb",
  "authors": [
    "You"
  ],
  "contributors": [
    "V5 contributors (combat logic, GPL-3.0)"
  ],
  "license": "GPL-3.0",
  "contact": {
    "sources": "https://github.com/thatguy9538/autominer/tree/ghost"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.ghostbot.GhostBotClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~1.21.10",
    "java": ">=21",
    "fabric-api": "*"
  },
  "mixins": [
    "ghostbot.mixins.json"
  ]
}
